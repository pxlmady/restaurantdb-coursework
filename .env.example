# Змінні для контейнера SQL Server (docker-compose.yml).
# Скопіюйте цей файл у .env і задайте власний пароль.
# Пароль sa: щонайменше 8 символів, великі й малі літери, цифри та символ (наприклад - або _).
# Не використовуйте в паролі символи ; = { } ' " $ ` \ : вони ламають рядок підключення Prisma
# або команди в терміналі.
MSSQL_SA_PASSWORD=
MSSQL_PORT=1433
