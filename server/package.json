{
  "name": "restaurantdb-server",
  "version": "0.1.0",
  "private": true,
  "description": "Серверна частина RestaurantDB (Node.js + Express + Prisma, SQL Server)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:check": "node scripts/check-db.js",
    "db:sample": "node scripts/read-sample.js",
    "api:check": "node scripts/api-check.js",
    "db:pull": "prisma db pull && node scripts/fix-schema.js && prisma format && prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "dotenv": "^17.2.3",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.0.0",
    "prisma": "^6.19.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
