# Змінні серверної частини. Скопіюйте цей файл у server/.env.
# PASSWORD замініть на пароль sa з кореневого .env (MSSQL_SA_PASSWORD).
# Якщо в кореневому .env змінено MSSQL_PORT, змініть і порт після localhost.
DATABASE_URL="sqlserver://localhost:1433;database=RestaurantDB;user=sa;password=PASSWORD;encrypt=true;trustServerCertificate=true"
PORT=3000
